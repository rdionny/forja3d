[
  {
    "type": "function",
    "function": {
      "name": "definir_especificacao",
      "description": "Registra os requisitos da peça na orientação de impressão, antes de modelar. Devolve problemas encontrados contra os limites da impressora.",
      "parameters": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "description": "Identificador em snake_case, sem acentos"
          },
          "finalidade": {
            "type": "string"
          },
          "material": {
            "type": "string",
            "enum": [
              "PLA",
              "PETG",
              "TPU"
            ]
          },
          "carga": {
            "type": "string",
            "enum": [
              "nenhuma",
              "leve",
              "media",
              "alta"
            ]
          },
          "ambiente": {
            "type": "string"
          },
          "dimensoes": {
            "type": "object",
            "description": "Caixa envolvente total em mm, na orientação de impressão. Em peça múltipla, use a maior parte.",
            "properties": {
              "x_mm": {
                "type": "number"
              },
              "y_mm": {
                "type": "number"
              },
              "z_mm": {
                "type": "number"
              },
              "tolerancia_mm": {
                "type": "number",
                "description": "Padrão 0.2"
              }
            },
            "required": [
              "x_mm",
              "y_mm",
              "z_mm"
            ]
          },
          "pecas": {
            "type": "integer",
            "description": "Número de sólidos separados"
          },
          "furos": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "quantidade": {
                  "type": "integer"
                },
                "diametro_nominal_mm": {
                  "type": "number"
                },
                "diametro_modelado_mm": {
                  "type": "number",
                  "description": "Diâmetro com a compensação aplicada"
                },
                "eixo": {
                  "type": "string",
                  "enum": [
                    "X",
                    "Y",
                    "Z"
                  ]
                },
                "passante": {
                  "type": "boolean"
                },
                "uso": {
                  "type": "string",
                  "description": "Exemplo: folga M4, autoatarraxante M3, rolamento 608"
                }
              },
              "required": [
                "quantidade",
                "diametro_nominal_mm",
                "diametro_modelado_mm",
                "eixo",
                "passante"
              ]
            }
          },
          "caracteristicas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "espessura_minima_mm": {
            "type": "number"
          },
          "orientacao_impressao": {
            "type": "string",
            "description": "Uma única orientação, igual à do modelo sobre Z = 0: qual face fica na mesa. O fatiador não gira a peça."
          },
          "premissas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "nome",
          "finalidade",
          "material",
          "carga",
          "dimensoes",
          "pecas",
          "furos",
          "orientacao_impressao",
          "premissas"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "executar_cad",
      "description": "Executa um script CadQuery completo em ambiente restrito e salva uma nova versão. Devolve medidas ou o erro.",
      "parameters": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string",
            "description": "Script Python completo, com a variável result"
          },
          "resumo_alteracao": {
            "type": "string"
          }
        },
        "required": [
          "codigo",
          "resumo_alteracao"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "verificar_peca",
      "description": "Compara a versão atual com a especificação e com as regras de impressão. Devolve bloqueios, alertas e medidas.",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "renderizar_vistas",
      "description": "Gera duas vistas isométricas de cantos opostos e as vistas frontal, lateral, superior e inferior da versão atual. As imagens chegam na mensagem seguinte.",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "definir_cores",
      "description": "Define as cores de impressão de uma parte, por troca manual de filamento. Não gera versão nova. Só com parte, não muda nada: devolve as cores atuais e as alturas em que a peça tem faces planas.",
      "parameters": {
        "type": "object",
        "properties": {
          "parte": {
            "type": "string",
            "description": "Nome da parte, igual à chave de result. Vale para todas as cópias dela."
          },
          "cor": {
            "type": "string",
            "description": "Cor da parte inteira. Com trocas, é a cor com que ela começa.",
            "enum": [
              "preto",
              "branco",
              "vermelho",
              "laranja",
              "amarelo",
              "verde",
              "azul",
              "roxo",
              "rosa",
              "marrom",
              "cinza",
              "bege"
            ]
          },
          "trocas": {
            "type": "array",
            "description": "Tudo o que está a partir de cada altura sai na cor indicada. Lista vazia remove as trocas.",
            "items": {
              "type": "object",
              "properties": {
                "z_mm": {
                  "type": "number",
                  "description": "Altura em que a cor muda, medida da base da parte"
                },
                "cor": {
                  "type": "string",
                  "enum": [
                    "preto",
                    "branco",
                    "vermelho",
                    "laranja",
                    "amarelo",
                    "verde",
                    "azul",
                    "roxo",
                    "rosa",
                    "marrom",
                    "cinza",
                    "bege"
                  ]
                }
              },
              "required": [
                "z_mm",
                "cor"
              ]
            }
          },
          "corpos": {
            "type": "array",
            "description": "Só para modelo importado com corpos separados: a cor de cada corpo.",
            "items": {
              "type": "object",
              "properties": {
                "corpo": {
                  "type": "string"
                },
                "cor": {
                  "type": "string",
                  "enum": [
                    "preto",
                    "branco",
                    "vermelho",
                    "laranja",
                    "amarelo",
                    "verde",
                    "azul",
                    "roxo",
                    "rosa",
                    "marrom",
                    "cinza",
                    "bege"
                  ]
                }
              },
              "required": [
                "corpo",
                "cor"
              ]
            }
          }
        },
        "required": [
          "parte"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "fatiar_peca",
      "description": "Fatia a versão atual com o OrcaSlicer e valida o G-code. Só funciona após a aprovação do usuário.",
      "parameters": {
        "type": "object",
        "properties": {
          "material": {
            "type": "string",
            "enum": [
              "PLA",
              "PETG",
              "TPU"
            ]
          },
          "qualidade": {
            "type": "string",
            "enum": [
              "fina",
              "otima",
              "padrao",
              "rascunho"
            ]
          },
          "paredes": {
            "type": "integer",
            "minimum": 2,
            "maximum": 8
          },
          "preenchimento_pct": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "suporte": {
            "type": "boolean"
          },
          "brim": {
            "type": "boolean"
          }
        },
        "required": [
          "material",
          "qualidade",
          "paredes",
          "preenchimento_pct",
          "suporte",
          "brim"
        ]
      }
    }
  }
]
